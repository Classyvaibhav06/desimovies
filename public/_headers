# Cloudflare Workers static-assets cache headers
# /_next/static/* files are content-hashed by Next.js — safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Anime posters/banners are baked at build time (scripts/build-anime.mjs).
# Filenames are not content-hashed, so cache for a week, not forever.
/anime/*
  Cache-Control: public, max-age=604800

# Everything else static (logos, icons): cache for a day
/*.png
  Cache-Control: public, max-age=86400

/*.svg
  Cache-Control: public, max-age=86400

/*.ico
  Cache-Control: public, max-age=86400
